#version 450
#extension GL_GOOGLE_include_directive : require
// Density constraint C_i = rho_i / rho_0 - 1 and its Lagrange multiplier
// lambda_i = -C_i / (sum_k |grad_k C_i|^2 + epsilon), over the neighbor list. The domain walls contribute analytic density.

layout(local_size_x = 128) in;
#include "pbf_common.glsl"

void main() {
	const uint i = gl_GlobalInvocationID.x;
	if ( i >= particleCount() )
		return;

	const vec3 position = predictedIn[i].xyz;
	const float h2 = kernelRadius() * kernelRadius();
	const float inverseRestDensity = params.kernel.w;

	float density = poly6( 0.0 );
	vec3 gradientI = vec3( 0.0 );
	float sumGradient2 = 0.0;
	const uint count = neighborCounts[i];
	for ( uint slot = 0u; slot < count; ++slot ) {
		const vec3 r = position - predictedIn[neighborAt( i, slot )].xyz;
		const float r2 = dot( r, r );
		if ( r2 >= h2 )
			continue;
		density += poly6( r2 );
		const vec3 gradient = spikyGradient( r, sqrt( r2 ) ) * inverseRestDensity;
		gradientI += gradient;
		sumGradient2 += dot( gradient, gradient );
	}
	storeLambda( i, position, density, gradientI, sumGradient2 );
}
