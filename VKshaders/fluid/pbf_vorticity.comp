#version 450
#extension GL_GOOGLE_include_directive : require
// Vorticity confinement f = epsilon (N x omega), N = grad|omega| / |grad|omega||: restores the small scale swirls that
// position based damping removes. Then the substep is finished: x = x*.

layout(local_size_x = 128) in;
#include "pbf_common.glsl"

void main() {
	const uint i = gl_GlobalInvocationID.x;
	if ( i >= particleCount() )
		return;

	const vec4 predicted = predictedIn[i];
	const vec4 omegaI = omegas[i];
	const float h2 = kernelRadius() * kernelRadius();

	vec3 eta = vec3( 0.0 );
	const uint count = neighborCounts[i];
	for ( uint slot = 0u; slot < count; ++slot ) {
		const uint j = neighborAt( i, slot );
		const vec3 r = predicted.xyz - predictedIn[j].xyz;
		const float r2 = dot( r, r );
		if ( r2 >= h2 )
			continue;
		eta += (omegas[j].w - omegaI.w) * spikyGradient( r, sqrt( r2 ) );
	}

	vec3 velocity = velocitiesIn[i].xyz;
	const float etaLength = length( eta );
	if ( etaLength > 1e-9 )
		velocity += params.motion.y * kernelRadius() * cross( eta / etaLength, omegaI.xyz );

	const float speed = length( velocity );
	if ( speed > params.motion.z )
		velocity *= params.motion.z / speed;

	positionsIn[i]  = vec4( predicted.xyz, positionsIn[i].w );
	velocitiesIn[i] = vec4( velocity, velocitiesIn[i].w );
	colorsIn[i]     = colorsOut[i];
}
