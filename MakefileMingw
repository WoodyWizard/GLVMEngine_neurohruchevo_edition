# GLVM Windows build cross-compiled on Linux with MinGW-w64 GCC.
#
#   export VULKAN_SDK=/path/to/VulkanSDK/<version>     # must contain Include/ and Lib/ (vulkan-1 import library)
#   make -f MakefileMingw -j$(nproc)                   # -> build/winGame.exe
#
# The executable must stay in build/: resources are looked up as ../<dir>/ relative to the executable.

CXX = x86_64-w64-mingw32-g++

ifeq ($(filter clean,$(MAKECMDGOALS)),)
ifeq ($(strip $(VULKAN_SDK)),)
$(error VULKAN_SDK is not set: export VULKAN_SDK=<Vulkan SDK directory with Include/ and Lib/>)
endif
endif

BUILD    = build
OBJ_DIR  = $(BUILD)/obj-mingw
CPPFLAGS = -I./include -I./textures -I$(VULKAN_SDK)/Include -MMD -MP
CXXFLAGS = -std=c++20 -O2 -g -Wall -Wextra -mconsole
LDFLAGS  = -L$(VULKAN_SDK)/Lib -static-libgcc -static-libstdc++ -static -mconsole
LDLIBS   = -lvulkan-1 -lgdi32 -luser32 -lwinmm

include make_files/sources.mk

SOURCES = $(GLVM_COMMON_SOURCES) $(GLVM_WINDOWS_SOURCES) $(GLVM_TEXTURE_SOURCES)
OBJECTS = $(patsubst ./%.cpp,$(OBJ_DIR)/%.o,$(SOURCES))
TARGET  = $(BUILD)/winGame.exe

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(CXX) $(LDFLAGS) $(OBJECTS) $(LDLIBS) -o $@

$(OBJ_DIR)/%.o: ./%.cpp
	@mkdir -p $(@D)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

clean:
	rm -rf $(OBJ_DIR) $(TARGET)

-include $(OBJECTS:.o=.d)
