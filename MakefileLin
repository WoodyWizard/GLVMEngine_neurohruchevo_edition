# GLVM Linux build (Wayland backend, Vulkan).
#
#   make -f MakefileLin -j$(nproc)              release-like build: build/linGame (-O2 -g)
#   make -f MakefileLin SANITIZE=1 -j$(nproc)   ASan + UBSan build: build/linGame-asan (separate objects)
#   make -f MakefileLin WERROR=1                treat warnings as errors
#   make -f MakefileLin run                     build and start the game
#   make -f MakefileLin gltf-tests              glTF loader tests: build/gltfTests [glTF-Sample-Assets/Models ...]
#   make -f MakefileLin fluid-demo              GPU fluid demo: build/fluidDemo (cd build && ./fluidDemo --help)
#   make -f MakefileLin fluid-tests             fluid simulation tests: build/fluidTests (run from the project root)
#   make -f MakefileLin clean
#
# The executable must stay in build/: resources are looked up as ../<dir>/ relative to the executable.

ifeq ($(origin CXX),default)
CXX = clang++
endif
ifeq ($(origin CC),default)
CC = clang
endif

SANITIZE ?= 0
WERROR   ?= 0

BUILD     = build
WARNINGS  = -Wall -Wextra -Wpedantic
CPPFLAGS += -I./include -I./textures -MMD -MP
CXXFLAGS += -std=c++20 -O2 -g $(WARNINGS)
CFLAGS   += -O2 -g $(WARNINGS)
LDLIBS   += -lvulkan -lwayland-client -lxcb -lX11 -lasound -pthread

ifeq ($(WERROR),1)
CXXFLAGS += -Werror
CFLAGS   += -Werror
endif

ifeq ($(SANITIZE),1)
SANITIZE_FLAGS = -fsanitize=address,undefined -fno-omit-frame-pointer
CXXFLAGS += $(SANITIZE_FLAGS)
CFLAGS   += $(SANITIZE_FLAGS)
LDFLAGS  += $(SANITIZE_FLAGS)
OBJ_DIR    = $(BUILD)/obj-asan
EXECUTABLE = linGame-asan
else
OBJ_DIR    = $(BUILD)/obj
EXECUTABLE = linGame
endif

include make_files/sources.mk

SOURCES         = $(GLVM_COMMON_SOURCES) $(GLVM_LINUX_SOURCES)
TEXTURE_SOURCES = $(GLVM_TEXTURE_SOURCES)
SOURCES_C       = $(GLVM_LINUX_C_SOURCES)

OBJECTS = $(patsubst ./%.cpp,$(OBJ_DIR)/%.o,$(SOURCES) $(TEXTURE_SOURCES)) \
	  $(patsubst ./%.c,$(OBJ_DIR)/%.o,$(SOURCES_C))
TARGET  = $(BUILD)/$(EXECUTABLE)

.PHONY: all run clean wayland-protocols udp-client gltf-tests fluid-demo fluid-tests

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(CXX) $(LDFLAGS) $(OBJECTS) $(LDLIBS) -o $@

$(OBJ_DIR)/%.o: ./%.cpp
	@mkdir -p $(@D)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

$(OBJ_DIR)/%.o: ./%.c
	@mkdir -p $(@D)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

run: $(TARGET)
	cd $(BUILD) && ./$(EXECUTABLE)

# Small UDP test client (src/Network/clientMain.cpp) talking to UDP_ServerLinux
udp-client: $(BUILD)/udpClient

$(BUILD)/udpClient: $(OBJ_DIR)/src/Network/clientMain.o $(OBJ_DIR)/src/Network/UDP_ClientLinux.o
	$(CXX) $(LDFLAGS) $^ -o $@

# glTF loader tests (tests/GltfTests.cpp): synthetic models, plus every .gltf/.glb of the directories given as arguments
GLTF_TEST_SOURCES = ./tests/GltfTests.cpp ./src/JsonParser.cpp ./src/Gltf/GltfLoader.cpp ./src/Gltf/GltfEvaluate.cpp \
	./src/Gltf/GltfImage.cpp ./src/Gltf/GltfEngineAdapter.cpp
gltf-tests: $(BUILD)/gltfTests

$(BUILD)/gltfTests: $(patsubst ./%.cpp,$(OBJ_DIR)/%.o,$(GLTF_TEST_SOURCES))
	$(CXX) $(LDFLAGS) $^ -o $@

-include $(OBJ_DIR)/tests/GltfTests.d

# GPU fluid demo (src/FluidDemo, a separate program on the fluid module) and the fluid tests
FLUID_DEMO_OBJECTS = $(patsubst ./%.cpp,$(OBJ_DIR)/%.o,$(GLVM_FLUID_DEMO_SOURCES) $(GLVM_FLUID_DEMO_LINUX_SOURCES)) \
	$(patsubst ./%.c,$(OBJ_DIR)/%.o,$(SOURCES_C))
FLUID_TEST_OBJECTS = $(patsubst ./%.cpp,$(OBJ_DIR)/%.o,$(GLVM_FLUID_TEST_SOURCES))
fluid-demo: $(BUILD)/fluidDemo
fluid-tests: $(BUILD)/fluidTests

$(BUILD)/fluidDemo: $(FLUID_DEMO_OBJECTS)
	$(CXX) $(LDFLAGS) $^ $(LDLIBS) -o $@

$(BUILD)/fluidTests: $(FLUID_TEST_OBJECTS)
	$(CXX) $(LDFLAGS) $^ -lvulkan -pthread -o $@

-include $(FLUID_DEMO_OBJECTS:.o=.d) $(FLUID_TEST_OBJECTS:.o=.d)

clean:
	rm -rf $(BUILD)/obj $(BUILD)/obj-asan $(BUILD)/linGame $(BUILD)/linGame-asan $(BUILD)/udpClient $(BUILD)/gltfTests \
		$(BUILD)/fluidDemo $(BUILD)/fluidTests

# Regenerate the protocol glue (needs wayland-scanner from wayland-devel)
WAYLAND_SCANNER ?= wayland-scanner
wayland-protocols:
	$(WAYLAND_SCANNER) client-header WaylandProtocols/xdg-shell.xml include/UnixApi/xdg-shell-client-protocol.h
	$(WAYLAND_SCANNER) private-code WaylandProtocols/xdg-shell.xml xdg-shell-protocol.c
	$(WAYLAND_SCANNER) client-header WaylandProtocols/pointer-constraints-unstable-v1.xml include/UnixApi/pointer-constraints-unstable-v1-client-protocol.h
	$(WAYLAND_SCANNER) private-code WaylandProtocols/pointer-constraints-unstable-v1.xml pointer-constraints-unstable-v1-protocol.c
	$(WAYLAND_SCANNER) client-header WaylandProtocols/relative-pointer-unstable-v1.xml include/UnixApi/relative-pointer-unstable-v1-client-protocol.h
	$(WAYLAND_SCANNER) private-code WaylandProtocols/relative-pointer-unstable-v1.xml relative-pointer-unstable-v1-protocol.c

-include $(OBJECTS:.o=.d)
