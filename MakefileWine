# GLVM Windows build for running under Wine, cross-compiled on Linux with llvm-mingw
# (https://github.com/mstorsjo/llvm-mingw). Vulkan headers come from ./Vulkan-Headers,
# the import library from Wine (libvulkan-1.a).
#
#   make -f MakefileWine LLVM_MINGW=/path/to/llvm-mingw -j$(nproc)     # -> build/winGame.exe
#   cd build && wine winGame.exe
#
# Optional overrides: WINE_VULKAN_LIB=/path/to/libvulkan-1.a, VULKAN_HEADERS=/path/to/Include

LLVM_MINGW     ?=
CXX             = $(if $(LLVM_MINGW),$(LLVM_MINGW)/bin/)x86_64-w64-mingw32-clang++
VULKAN_HEADERS ?= ./Vulkan-Headers/Include
WINE_VULKAN_LIB ?= $(firstword $(wildcard /usr/lib64/wine/x86_64-windows/libvulkan-1.a \
	/usr/lib/wine/x86_64-windows/libvulkan-1.a /usr/lib/x86_64-linux-gnu/wine/x86_64-windows/libvulkan-1.a \
	/usr/lib/wine-vanilla-*/wine/x86_64-windows/libvulkan-1.a /opt/wine-*/lib/wine/x86_64-windows/libvulkan-1.a))

ifeq ($(filter clean,$(MAKECMDGOALS)),)
ifeq ($(strip $(WINE_VULKAN_LIB)),)
$(error Wine libvulkan-1.a not found: pass WINE_VULKAN_LIB=<path to libvulkan-1.a from the Wine package>)
endif
endif

BUILD    = build
OBJ_DIR  = $(BUILD)/obj-wine
CPPFLAGS = -I./include -I./textures -I$(VULKAN_HEADERS) -MMD -MP
CXXFLAGS = -std=c++20 -O2 -g -Wall -Wextra
LDLIBS   = $(WINE_VULKAN_LIB) -lgdi32 -luser32 -lwinmm

include make_files/sources.mk

SOURCES = $(GLVM_COMMON_SOURCES) $(GLVM_WINDOWS_SOURCES) $(GLVM_TEXTURE_SOURCES)
OBJECTS = $(patsubst ./%.cpp,$(OBJ_DIR)/%.o,$(SOURCES))
TARGET  = $(BUILD)/winGame.exe

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(CXX) $(OBJECTS) $(LDLIBS) -o $@

$(OBJ_DIR)/%.o: ./%.cpp
	@mkdir -p $(@D)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

clean:
	rm -rf $(OBJ_DIR) $(TARGET)

-include $(OBJECTS:.o=.d)
