# GLVM native Windows build from PowerShell with MinGW-w64 GCC (for example from MSYS2) in PATH.
# Run from the project root (the Vulkan SDK installer sets VULKAN_SDK):
#   mingw32-make -f make_files/Windows/MakefileWinPS        -> build\winGame.exe
# The executable must stay in build\: resources are looked up as ..\<dir>\ relative to the executable.

SHELL := powershell.exe
.SHELLFLAGS := -NoProfile -Command

CXX = x86_64-w64-mingw32-c++

ifeq ($(filter clean,$(MAKECMDGOALS)),)
ifeq ($(strip $(VULKAN_SDK)),)
$(error VULKAN_SDK is not set: install the Vulkan SDK or set VULKAN_SDK=C:/VulkanSDK/<version>)
endif
endif

BUILD    = build
OBJ_DIR  = $(BUILD)/obj-win
CPPFLAGS = -I./include -I./textures -I$(VULKAN_SDK)/Include -MMD -MP
CXXFLAGS = -std=c++20 -O2 -g -Wall -mconsole
LDFLAGS  = -L$(VULKAN_SDK)/Lib -static-libgcc -static-libstdc++ -static -mconsole
LDLIBS   = -lvulkan-1 -lgdi32 -luser32 -lwinmm

include make_files/sources.mk

SOURCES = $(GLVM_COMMON_SOURCES) $(GLVM_WINDOWS_SOURCES) $(GLVM_TEXTURE_SOURCES)
OBJECTS = $(patsubst ./%.cpp,$(OBJ_DIR)/%.o,$(SOURCES))
TARGET  = $(BUILD)/winGame.exe

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(CXX) $(LDFLAGS) $(OBJECTS) $(LDLIBS) -o $@

$(OBJ_DIR)/%.o: ./%.cpp
	New-Item -Force -ItemType Directory -Path $(@D) | Out-Null
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

clean:
	Remove-Item -Recurse -Force -ErrorAction SilentlyContinue $(OBJ_DIR), $(TARGET)

-include $(OBJECTS:.o=.d)
