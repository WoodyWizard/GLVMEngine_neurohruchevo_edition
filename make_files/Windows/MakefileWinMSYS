# GLVM native Windows build inside an MSYS2 shell (UCRT64: g++, CLANG64: CXX=clang++).
# Packages (UCRT64): pacman -S make mingw-w64-ucrt-x86_64-gcc mingw-w64-ucrt-x86_64-vulkan-devel
# Run from the project root:
#   make -f make_files/Windows/MakefileWinMSYS -j$(nproc)    -> build/winGame.exe
# The executable must stay in build/: resources are looked up as ../<dir>/ relative to the executable.

ifeq ($(origin CXX),default)
CXX = g++
endif

BUILD    = build
OBJ_DIR  = $(BUILD)/obj-msys
CPPFLAGS = -I./include -I./textures -MMD -MP
CXXFLAGS = -std=c++20 -O2 -g -Wall -Wextra -mconsole
LDFLAGS  = -static-libgcc -static-libstdc++ -mconsole
LDLIBS   = -lvulkan-1 -lgdi32 -luser32 -lwinmm

include make_files/sources.mk

SOURCES = $(GLVM_COMMON_SOURCES) $(GLVM_WINDOWS_SOURCES) $(GLVM_TEXTURE_SOURCES)
OBJECTS = $(patsubst ./%.cpp,$(OBJ_DIR)/%.o,$(SOURCES))
TARGET  = $(BUILD)/winGame.exe

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(CXX) $(LDFLAGS) $(OBJECTS) $(LDLIBS) -o $@

$(OBJ_DIR)/%.o: ./%.cpp
	@mkdir -p $(@D)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

clean:
	rm -rf $(OBJ_DIR) $(TARGET)

-include $(OBJECTS:.o=.d)
